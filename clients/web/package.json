{
  "name": "@fixr/web",
  "version": "0.1.0",
  "description": "Embeddable \"fix this UI\" reporter for web apps: prompt + screenshot to a fixr Worker.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/fixr.global.js",
  "jsdelivr": "./dist/fixr.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iife": "./dist/fixr.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "echo": "node ../../spec/echo-server/server.mjs --port 8787 --out ./out",
    "demo": "node demo/serve.mjs"
  },
  "peerDependencies": {
    "html-to-image": "^1.11.0"
  },
  "peerDependenciesMeta": {
    "html-to-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.7",
    "html-to-image": "^1.11.13",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
